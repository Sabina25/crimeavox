{
  "name": "@portabletext/editor",
  "version": "8.2.12",
  "description": "Portable Text Editor made in React",
  "keywords": [
    "collaborative",
    "content",
    "editor",
    "portable-text",
    "portable-text-editor",
    "realtime",
    "sanity",
    "structure",
    "text"
  ],
  "homepage": "https://www.sanity.io/",
  "bugs": {
    "url": "https://github.com/portabletext/editor/issues"
  },
  "license": "MIT",
  "author": "Sanity.io <hello@sanity.io>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/portabletext/editor.git",
    "directory": "packages/editor"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./behaviors": "./lib/behaviors/index.js",
    "./plugins": "./lib/plugins/index.js",
    "./selectors": "./lib/selectors/index.js",
    "./traversal": "./lib/traversal/index.js",
    "./utils": "./lib/utils/index.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@portabletext/to-html": "^6.0.0",
    "@sanity/diff-match-patch": "^3.2.1",
    "@xstate/react": "^6.1.0",
    "obug": "^3.0.0",
    "scroll-into-view-if-needed": "^3.1.0",
    "xstate": "^5.32.5",
    "@portabletext/html": "^2.0.2",
    "@portabletext/keyboard-shortcuts": "^3.0.0",
    "@portabletext/patches": "^3.0.4",
    "@portabletext/repair": "^1.0.2",
    "@portabletext/schema": "^3.1.0"
  },
  "devDependencies": {
    "@sanity/diff-patch": "^6.0.0",
    "@sanity/json-match": "^1.0.5",
    "@sanity/pkg-utils": "^12.3.0",
    "@sanity/tsconfig": "^2.2.1",
    "@types/node": "^24",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-istanbul": "^5.0.4",
    "jsdom": "^27.2.0",
    "oxc-transform-react": "^0.145.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0",
    "@portabletext/test": "^2.1.3",
    "racejar": "4.0.2",
    "thumbjar": "0.0.0"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pkg-utils build --strict --check",
    "build:android": "tsc --project android/tsconfig.page.json && vite build --config android/vite.config.ts",
    "check:types": "tsc && tsc --project android/tsconfig.json",
    "check:types:watch": "tsc --watch",
    "clean": "del .turbo && del lib && del node_modules",
    "dev": "pkg-utils watch",
    "test": "vitest --run",
    "test:android": "vitest --config vitest.android.config.ts --project device",
    "test:android:unit": "vitest --run --config vitest.android.config.ts --project android-unit",
    "test:browser": "vitest --run --project browser",
    "test:browser:chromium": "vitest --run --project \"browser (chromium)\"",
    "test:browser:chromium:watch": "vitest --project \"browser (chromium)\"",
    "test:browser:firefox": "vitest --run --project \"browser (firefox)\"",
    "test:browser:firefox:watch": "vitest --project \"browser (firefox)\"",
    "test:browser:watch": "vitest --project browser",
    "test:browser:webkit": "vitest --run --project \"browser (webkit)\"",
    "test:browser:webkit:watch": "vitest --project \"browser (webkit)\"",
    "test:unit": "vitest --run --project unit && pnpm test:android:unit",
    "test:unit:watch": "vitest --project unit",
    "test:watch": "vitest",
    "wire-catalogue:markdown": "node scripts/generate-wire-catalogue.ts"
  }
}