{
  "name": "@pierre/highlights",
  "version": "0.3.0",
  "description": "A fast code highlighter written in WebAssembly Text(Wat), from Pierre",
  "license": "apache-2.0",
  "files": [
    "dist/",
    "NOTICE.md"
  ],
  "type": "module",
  "main": "./dist/default.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/workerd.js",
      "import": "./dist/default.js",
      "default": "./dist/default.js"
    },
    "./themes": {
      "types": "./dist/themes.d.ts",
      "import": "./dist/themes.js",
      "default": "./dist/themes.js"
    },
    "./themes/*": {
      "types": "./dist/themes/*.d.ts",
      "import": "./dist/themes/*.js",
      "default": "./dist/themes/*.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "binaryen": "132.0.0",
    "shiki": "4.4.1",
    "tree-sitter-highlight": "1.1.2",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "wabt": "1.0.39"
  },
  "meta": {
    "highlights.wasm": 282255,
    "highlights.wasm.gz": 122205
  },
  "scripts": {}
}