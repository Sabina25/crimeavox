import * as v from "valibot";
import { Condition, ConditionInsight, ConditionOutcome, ConditionRead, ScopeAssignment } from "@sanity/groq-condition-describe";
import { SanityDocument } from "@sanity/types";
/**
 * An activity is `active` from stage entry (or `skipped` when its `filter`
 * excluded it) until a terminal status resolves it — there is no pre-active
 * state. The authored action `status:` sugar (and the `status.set` op it
 * desugars to) is constrained to {@link TerminalActivityStatus}.
 */
type ActivityStatus = 'active' | 'done' | 'skipped' | 'failed';
/**
 * The statuses an activity can be resolved INTO — what `status.set` accepts.
 * A health axis, not a decision axis: a routine decision (decline, send back,
 * hold) resolves `done` and routes via a field write; `failed` means the work
 * genuinely could not complete. Only `done`/`skipped` satisfy
 * `$allActivitiesDone` — a `failed` activity blocks it permanently, surfacing
 * via `$anyActivityFailed`.
 */
type TerminalActivityStatus = 'done' | 'skipped' | 'failed';
declare function isTerminalActivityStatus(status: ActivityStatus): status is TerminalActivityStatus;
declare const SIGNAL_SEMANTICS: readonly ['signal.positive', 'signal.caution', 'signal.critical'];
type SignalSemantic = (typeof SIGNAL_SEMANTICS)[number];
/** A define-time validated `custom.<camelCaseMeaning>` value. */
type CustomSemantic = `custom.${string}`;
type Semantic = SignalSemantic | CustomSemantic;
declare const DECISION_SEMANTICS: readonly ['decision.accept', 'decision.decline'];
type DecisionSemantic = (typeof DECISION_SEMANTICS)[number];
declare const ACTION_SEMANTICS: readonly ["decision.accept", "decision.decline", "signal.positive", "signal.caution", "signal.critical"];
type ActionSemantic = DecisionSemantic | Semantic;
/**
 * The three field scopes a field entry can live in. Also the
 * group-declaration levels: a `groups` array lives at exactly these three
 * nodes, so `DefinitionGroupSite.level` reuses this vocabulary.
 */
type FieldScope = 'workflow' | 'stage' | 'activity';
/** Document-value permissions. Grants ({@link Grant} in ./authorization.ts) compose most-permissive-wins. */
declare const DOCUMENT_VALUE_PERMISSIONS: readonly ['create', 'manage', 'read', 'update'];
type DocumentValuePermission = (typeof DOCUMENT_VALUE_PERMISSIONS)[number];
/** The write operations Content Lake exposes to mutation guards. */
type LakeMutationGuardAction = 'create' | 'update' | 'delete';
/** Lake operations plus the authored lifecycle actions the compiler translates. */
type MutationGuardAction = LakeMutationGuardAction | 'publish' | 'unpublish';
/**
 * BPMN-aligned classification of an activity by its EXECUTOR. Purely
 * advisory and always DERIVED from the activity's shape (`target` marks
 * off-system manual work, action shapes decide the rest) — it changes no
 * gating or runtime.
 */
declare const ACTIVITY_KINDS: readonly ['user', 'service', 'script', 'manual', 'receive'];
type ActivityKind = (typeof ACTIVITY_KINDS)[number];
/**
 * Who, if anyone, fires an activity's actions, derived ahead-of-time from
 * the activity's shape alone: `'autonomous'` = every action is cascade-fired
 * (no caller fires anything); `'interactive'` = only fireAction-fired
 * actions; `'off-system'` = `target` present; `'hybrid'` = mixed. Advisory,
 * rendered on insight/evaluation nodes — never gating.
 */
declare const EXECUTOR_CLASSIFICATIONS: readonly ['autonomous', 'interactive', 'off-system', 'hybrid'];
type ExecutorClassification = (typeof EXECUTOR_CLASSIFICATIONS)[number];
/**
 * Advisory classification of a declared {@link Group} by its informational
 * ROLE, never a rendering treatment: `'core'` marks content central to
 * understanding the workflow (condensed views include these first);
 * `'details'` marks depth on demand. Unset = a plain group. Consumers
 * reading a definition as data MUST treat an unknown kind as unset — growing
 * this list is an engine version bump, like every stored enum.
 */
declare const GROUP_KINDS: readonly ['core', 'details'];
type GroupKind = (typeof GROUP_KINDS)[number];
/**
 * What KIND of actor drove an action, recorded on the `actionFired` history
 * entry for the audit-trail "who did this?" glyph. Distinct from
 * {@link ActivityKind} (the intended execution lane) — any driver can fire
 * any kind. New entries stamp `'person'`; `'agent'`/`'service'`/`'engine'`
 * remain as read vocabulary for stored entries.
 */
declare const DRIVER_KINDS: readonly ['person', 'agent', 'service', 'engine'];
type DriverKind = (typeof DRIVER_KINDS)[number];
/**
 * Global Document References (GDR).
 *
 * Every cross-document reference in the engine API uses this shape so
 * workflow state can live in one Sanity resource while subjects /
 * ancestors / effect-binding refs point at docs in *different* resources.
 *
 * Resource schemes mirror `@sanity/client`'s `ClientConfigResource`
 * discriminator. A GDR id is a typed URI:
 *
 *   dataset:<projectId>:<dataset>:<documentId>
 *   canvas:<resourceId>:<documentId>
 *   media-library:<resourceId>:<documentId>
 *   dashboard:<resourceId>:<documentId>
 *
 * The `type` field carries the doc's schema `_type` so consumers don't
 * need a separate lookup to know what they're pointing at.
 */
type GdrScheme = 'dataset' | 'canvas' | 'media-library' | 'dashboard';
/**
 * Resource-qualified document URI with a {@link GdrScheme} prefix. Construct
 * it with {@link gdrUri}, {@link gdrFromResource}, or {@link refDataset}.
 * Use {@link parseGdr} to validate a string's complete addressing format.
 *
 * Dataset URIs require the stable document ID, such as `article-1`, without
 * a `drafts.` or `versions.<release>.` prefix. Select draft and release
 * content through {@link WorkflowInstance.perspective}.
 */
type GdrUri = `${GdrScheme}:${string}`;
/**
 * The engine's reference value — deliberately NOT a lake reference, and
 * spelled differently on purpose (`id`/`type`, never `_ref`/`_id`):
 *
 * - **`id` is a URI, not a bare doc id**, because workflow references cross
 *   resources (another dataset, a media library) and a bare `_id` is only
 *   meaningful inside one dataset. Everything resource-aware — client
 *   routing, spawn discovery, guard target resolution — reads the resource
 *   out of this URI. It is stripped to a bare lake id at exactly one
 *   boundary: `paramsForLake` (core/params.ts), when a query actually runs
 *   against a lake.
 * - **`type` carries the target's schema type so consumers don't need a
 *   fetch — as stamped by the ref's constructor, never verified against the
 *   target.** Engine-built refs stamp it from real data (a projection row's
 *   `_type`, the `releaseRef` constructor); a caller-supplied ref's `type`
 *   is a trusted claim. Three advisory surfaces read it: the declared-subject-type
 *   contract (an entry's `types: [...]` accepts/rejects incoming refs —
 *   `refTypeIssues` at start `initialFields` and spawn `with`), start
 *   applicability ("which definitions accept a doc of this `_type`" —
 *   `acceptsDocumentType`), and guard `match.types` inference from resolved
 *   targets (`resolveMatchTypes`). All must work when the target lives in a
 *   resource the reader can't (or shouldn't) fetch from.
 *
 * In rendered GROQ this shape is what a reference-held value exposes
 * (`$fields.<entry>.id` / `.type`) — whereas `_id`/`_type` belong to
 * documents you hold (lake rows, `$row`, a dereferenced singular `doc.ref`).
 * The spelling is not a namespace guarantee: a content document can carry
 * its own `id`/`type` fields — what you're reading follows what the entry's
 * declared kind puts in your hand, never the key's spelling.
 *
 * `TType` preserves the `type` literal the constructors ({@link refDataset},
 * {@link gdrRef}, …) were called with, so a constructed ref satisfies
 * literal-typed targets (e.g. a `release.ref` value's `"system.release"`).
 */
interface GlobalDocumentReference<TType extends string = string> {
  /** URI: `<scheme>:<...id-parts>` */
  id: GdrUri;
  /** Document `_type` (schema name) */
  type: TType;
}
interface ParsedGdr {
  scheme: GdrScheme;
  /** For `dataset`: `<projectId>` */
  projectId?: string;
  /** For `dataset`: `<dataset>` */
  dataset?: string;
  /** For `canvas` / `media-library` / `dashboard`: `<resourceId>` */
  resourceId?: string;
  /** The trailing `<documentId>` part — what `_id` of the target doc is */
  documentId: string;
}
/**
 * Parses a GDR URI into its scheme and addressing parts. Throws for an
 * unknown scheme, malformed addressing, or a dataset document ID prefixed
 * with `drafts.` or `versions.<release>.`. Use the stable document ID and
 * select draft or release content through {@link WorkflowInstance.perspective}.
 */
declare function parseGdr(uri: string): ParsedGdr;
/**
 * Parse a GDR URI, returning `undefined` instead of throwing when the string
 * is not a GDR (or is malformed). The "is this a GDR, and if so its parts"
 * primitive — every "parse a ref, treat unparseable as not-a-GDR" call site
 * routes through this rather than re-spelling the try/catch.
 */
declare function tryParseGdr(uri: string): ParsedGdr | undefined;
/**
 * Creates a {@link GdrUri} from addressing parts. For datasets, `documentId`
 * must be the stable ID; `drafts.` and `versions.<release>.` prefixes throw.
 * Select draft or release content through {@link WorkflowInstance.perspective}.
 */
declare function gdrUri(parts: {
  scheme: 'dataset';
  projectId: string;
  dataset: string;
  documentId: string;
} | {
  scheme: 'canvas' | 'media-library' | 'dashboard';
  resourceId: string;
  documentId: string;
}): GdrUri;
/**
 * Extract the bare document `_id` from a GDR URI — what
 * `*[_id == $docId]` in GROQ needs.
 */
declare function extractDocumentId(gdrUriString: string): string;
/**
 * A map binding each resource-alias name to the physical {@link WorkflowResource}
 * it resolves to at deploy. Parallels the role-alias map: where role aliases map
 * a role to its fulfillers, resource aliases map a logical content reference
 * (`@<alias>:<id>`) to a physical resource. Swapping the map is how the same
 * source definitions deploy to different environments.
 */
type ResourceAliases = Record<string, WorkflowResource>;
/**
 * Creates a typed reference to a dataset document. Pass the stable document
 * ID; `drafts.` and `versions.<release>.` prefixes throw. Select draft or
 * release content through {@link WorkflowInstance.perspective}.
 */
declare function refDataset<TType extends string = string>({ projectId, dataset, documentId, type }: {
  projectId: string;
  dataset: string;
  documentId: string;
  type: TType;
}): GlobalDocumentReference<TType>;
/** Args for the single-resource ref constructors ({@link refCanvas}, {@link refMediaLibrary}, {@link refDashboard}). */
interface ResourceRefArgs<TType extends string> {
  resourceId: string;
  documentId: string;
  type: TType;
}
/** Make a GDR pointer to a Canvas-resource doc. */
declare function refCanvas<TType extends string = string>({ resourceId, documentId, type }: ResourceRefArgs<TType>): GlobalDocumentReference<TType>;
/** Make a GDR pointer to a Media-Library-resource doc. */
declare function refMediaLibrary<TType extends string = string>({ resourceId, documentId, type }: ResourceRefArgs<TType>): GlobalDocumentReference<TType>;
/** Make a GDR pointer to a Dashboard-resource doc. */
declare function refDashboard<TType extends string = string>({ resourceId, documentId, type }: ResourceRefArgs<TType>): GlobalDocumentReference<TType>;
/**
 * The resource a Sanity client is configured against — mirrors
 * `@sanity/client`'s `ClientConfigResource` discriminator. For
 * `dataset`, `id` is `<projectId>.<dataset>`. For the others, `id` is
 * the resource id.
 */
type WorkflowResource = {
  type: 'dataset';
  id: string;
} | {
  type: 'canvas';
  id: string;
} | {
  type: 'media-library';
  id: string;
} | {
  type: 'dashboard';
  id: string;
};
/**
 * Split a dataset resource id (`<projectId>.<dataset>`) into its parts — the
 * one parser for the format, shared by {@link gdrFromResource} and the React
 * adapters' store routing. Throws on a malformed id: missing separator, or an
 * empty project / dataset part.
 */
declare function datasetResourceParts(id: string): {
  projectId: string;
  dataset: string;
};
/**
 * The `@sanity/client`-config fragment that addresses a {@link WorkflowResource}
 * — the one home for the dataset-vs-resource branch every client-building host
 * (CLI, MCP) would otherwise reimplement. A dataset addresses via the classic
 * `{projectId, dataset}` config (the proven path, and it keeps
 * `client.listen()` on well-trodden ground); the other resource types have no
 * projectId/dataset split, so they pass through as a `resource` directly.
 *
 * Returns a plain fragment (not a client) so the engine stays free of a
 * runtime `@sanity/client` dependency — callers spread it into their own
 * `createClient` call alongside their auth/host params.
 */
declare function clientConfigFromResource(res: WorkflowResource): {
  projectId: string;
  dataset: string;
} | {
  resource: WorkflowResource;
};
/**
 * Creates a {@link GdrUri} for a document in the supplied resource. Dataset
 * document IDs must be stable; `drafts.` and `versions.<release>.` prefixes
 * throw. Select draft or release content through {@link WorkflowInstance.perspective}.
 */
declare function gdrFromResource(res: WorkflowResource, documentId: string): GdrUri;
/**
 * Format a {@link WorkflowResource} as a resource-shaped GDR — `<type>:<id>`
 * with no document part (`dataset:abc123.production`, `media-library:mlXyz`).
 * The string form for naming a *resource* (not a document in it) across an
 * API boundary — e.g. the per-call workflow-environment address an MCP tool
 * takes. Inverse of {@link parseResourceGdr}.
 */
declare function resourceGdr(res: WorkflowResource): string;
/**
 * Parse a resource-shaped GDR (`<type>:<id>`, no document part) into the
 * {@link WorkflowResource} it names. The one grammar for resource addresses —
 * hosts validate/parse through this instead of hand-rolling the split.
 * Throws on unknown type, extra `:` parts (that shape is a document GDR —
 * see {@link parseGdr}), or a malformed dataset id.
 */
declare function parseResourceGdr(uri: string): WorkflowResource;
/**
 * The {@link WorkflowResource} an already-parsed GDR addresses. Total: a caller
 * holding a {@link ParsedGdr} has already proven the URI parsed, so there's no
 * not-a-GDR case to handle. The `?? ''` only satisfies the cross-scheme-optional
 * `resourceId` type — {@link parseGdr} guarantees it is present per non-dataset
 * scheme, so the fallback never fires.
 */
declare function resourceFromParsed(parsed: ParsedGdr): WorkflowResource;
/** Whether two workflow resources address the same place. */
declare function sameResource(a: WorkflowResource, b: WorkflowResource): boolean;
/**
 * A GDR URI stripped back to its bare document `_id`; a non-GDR string passes
 * through unchanged. The one canonical "URI → bare id" transform — use it
 * wherever a stored ref (which may be a full GDR URI, or already bare) must
 * become a lake-queryable `_id`.
 */
declare function toBareId(id: string): string;
/**
 * Creates a typed document reference in the supplied resource. Dataset
 * references require a stable document ID, as described by {@link gdrFromResource}.
 */
declare function gdrRef<TType extends string = string>({ res, documentId, type }: {
  res: WorkflowResource;
  documentId: string;
  type: TType;
}): GlobalDocumentReference<TType>;
/** Type filter for GDR shape. */
declare function isGdr(value: unknown): value is GlobalDocumentReference;
/**
 * The stored stamp: self-asserted advisory provenance — "via what", distinct
 * from the actor's "who". Configured once at `createEngine`, never per call,
 * and never an authorization input. `runtime` is always present; the declared
 * half is optional.
 */
interface ExecutionContext {
  /** Inferred JavaScript runtime: `browser` | `node` | `worker` | `edge` | `deno` | `bun` | `unknown`. */
  runtime: string;
  /** Declared role — free string; see {@link EXECUTION_KINDS} for the shipped vocabulary. */
  kind?: string;
  /** Declared instance label, e.g. `workflow-cli` or `publish-proxy`. */
  id?: string;
}
/** The declarable half of {@link ExecutionContext} — what `createEngine` accepts. */
type DeclaredExecutionContext = Pick<ExecutionContext, 'kind' | 'id'>;
/**
 * Well-known {@link ExecutionContext.kind} values. The field is a free
 * string — these are the shipped vocabulary, not a closed set. `interactive`
 * is the generic human-session fallback when `studio`/`sdkApp` don't apply;
 * `server` is a proxy acting with a user's token; `drainer` is an
 * effect-drain runtime.
 */
declare const EXECUTION_KINDS: {
  readonly interactive: 'interactive';
  readonly server: 'server';
  readonly cli: 'cli';
  readonly mcp: 'mcp';
  readonly drainer: 'drainer';
  readonly script: 'script';
  readonly test: 'test';
  readonly studio: 'studio';
  readonly sdkApp: 'sdk';
};
/**
 * A LOADED candidate document. Applicability evaluates content, so a ref or
 * bare id is not enough: the doc must carry its schema `_type` plus whatever
 * attributes `start.filter` predicates read — under whatever perspective
 * the caller loaded it with.
 */
interface CandidateDocument {
  _type: string;
  [key: string]: unknown;
}
/** The definition surface the start contexts read — structural, so authored,
 *  stored, and deployed definition shapes all fit. `name` binds
 *  `$definition` and names the definition in a broken-predicate error. */
interface ApplicabilitySource {
  name?: string | undefined;
  lifecycle?: WorkflowLifecycle | undefined;
  fields?: FieldEntry[] | undefined;
  start?: {
    kind?: StartKind | undefined;
    filter?: string | undefined;
    requirements?: StartRequirement[] | undefined;
  } | undefined;
}
/**
 * The caller-side half of the start contexts — everything the evaluating
 * surface knows that the definition doesn't. Every member is optional
 * because the surfaces genuinely differ (a pure consumer may hold no clock):
 * An absent binding evaluates each read of it to GROQ null, and where that
 * null lands decides the verdict — a predicate that can't decide without
 * the binding fails closed, while a count-of-matches clause over values
 * every row stores passes vacuously (in GROQ null equals only null, so the
 * unbound read matches no stored value). The vars themselves are
 * inventoried in `START_FILTER_VARS` / `START_REQUIREMENT_VARS`; the caller's
 * `$fields` map is NOT scope — `start.filter` never binds it, and
 * `explainStartRequirement` takes it as its own argument.
 */
interface StartScope {
  /** The engine's partition, bound as `$tag`. */
  partition?: string | undefined;
  /** ISO clock reading — binds `$now`. */
  now?: string | undefined;
  /** Resource-qualified identity of the prospective subject. Unlike a loaded
   *  document's bare `_id`, this stays collision-free across resources. */
  subject?: GdrUri | undefined;
  /**
   * The engine-owned start slice, for predicates that read `*[...]` or for a
   * `singleSubject` requirement — invoked lazily only when evaluation needs it.
   * Each row exposes exactly `{definition, subject, completedAt}`; completed
   * rows are included, so authors qualify in-flight
   * themselves (`!defined(completedAt)`). Absent ⇒ a dataset-reading filter
   * fails closed (this surface cannot see the dataset, so it cannot decide),
   * while a dataset-reading requirement THROWS — see
   * {@link explainStartRequirement}.
   */
  fetchDataset?: (() => Promise<unknown[]>) | undefined;
}
/**
 * The structured half of applicability: does the definition's subject entry
 * ({@link isSubjectEntry} — the `subject` kind, workflow scope, at most one
 * by deploy invariant) accept `documentType`? The kind is the discriminator,
 * so a definition surfaces from its SUBJECT's document picker and nowhere
 * else; the start dialog collects the remaining required entries (their
 * fail-hard validation backstops). A definition with no subject entry takes no
 * subject and never matches. A subject without `types` accepts any type that is
 * not a system document ({@link isSystemDocumentType}). Naming a reserved
 * `sanity.` or `system.` type in `types` accepts it, but naming a type the engine
 * owns and writes for itself never does.
 * Cheap and indexable — no GROQ evaluation — so a consumer can pre-filter
 * before loading document content.
 */
declare function acceptsDocumentType(definition: Pick<ApplicabilitySource, 'fields'>, documentType: string): boolean;
/**
 * The full applicability derivation for one definition against one loaded
 * document: startable ∧ {@link acceptsDocumentType} ∧ `start.filter`.
 * "Deployed" is the caller's premise — feed it deployed definitions (the
 * engine verb `definitionsForDocument` does). Throws when `document` carries
 * no `_type` — that's a ref or a projection, not a loaded document. A
 * `start.filter` that doesn't PARSE also throws, naming the definition —
 * that's a malformed definition (only writable by bypassing deploy
 * validation), and silently excluding it would make it vanish from every
 * picker with nothing screaming; only an evaluation result of GROQ null
 * ("can't decide") fails closed.
 */
declare function isDefinitionApplicable(args: {
  definition: ApplicabilitySource;
  document: CandidateDocument;
  /** Caller-side filter bindings — omit for the bare candidate-doc context. */
  scope?: StartScope;
}): Promise<boolean>;
/**
 * Filter `definitions` to the ones applicable to `document`, preserving
 * input order — surface ALL matches; the engine ranks nothing.
 */
declare function applicableDefinitions<T extends ApplicabilitySource>(args: {
  definitions: readonly T[];
  document: CandidateDocument;
  /** Caller-side filter bindings, shared by every definition's evaluation. */
  scope?: StartScope;
}): Promise<T[]>;
/**
 * Evaluate one `start.filter` in the start-filter context: `document` (may
 * be absent — a root read is then GROQ null, fail-closed or vacuous-pass by
 * shape) as the GROQ root, the {@link StartScope} bindings plus
 * `$definition`, and — when `analyzeCondition` says the filter reads the
 * dataset — the scope's fetched slice as `*`. Cheap pure evaluation otherwise: no I/O rides a
 * filter that needs neither. GROQ null ("can't decide") is `false` — every consumer of
 * this verdict fails closed; a parse/evaluation THROW is a malformed
 * predicate, not an unevaluable one — rethrown loud, naming the definition,
 * so every read surface that evaluates the filter reports the same context.
 * A failed slice FETCH propagates as itself: transport trouble, never
 * definition blame.
 */
declare function evaluateStartFilter(args: {
  filter: string;
  definition: Pick<ApplicabilitySource, 'name'>;
  document?: CandidateDocument | undefined;
  scope?: StartScope | undefined;
}): Promise<boolean>;
/**
 * Explain one start GROQ requirement in the start-requirement context: no root (the
 * subject rides `$fields.<entry>.id` — deploy rejects a root read), the
 * {@link StartScope} bindings plus `$definition` and the caller's `$fields`
 * map, and the scope's fetched slice as `*` when the predicate reads the
 * dataset. Returns the full {@link ConditionInsight} — `outcome` is the
 * verdict (`'satisfied'` allows; `'unsatisfied'`/`'unevaluable'` refuse,
 * fail-closed) and the atom breakdown is what lets a surface disable its
 * start affordance AND say why. One evaluator serves both moments:
 * `startInstance` enforces the outcome, the `evaluateStart` verb pre-flights
 * it.
 *
 * A dataset-reading predicate with no slice provider THROWS instead of
 * failing closed: unlike a picker that merely hides a row, this verdict
 * refuses starts — evaluating over an empty `*` would let a `count()`-style
 * rule pass vacuously, and a silent "not allowed" would misreport a caller
 * bug as an author verdict. Parse/evaluation throws rethrow naming the
 * definition, like the filter's; a failed slice FETCH propagates as itself.
 */
declare function explainStartRequirement(args: {
  query: string;
  definition: Pick<ApplicabilitySource, 'name' | 'fields'>;
  /** The caller's input entries as a `$fields` map — the engine verbs build
   *  it with `startFieldsParam` (field resolution's projection), so the
   *  predicate can only see values the resolution would persist. */
  fields: Record<string, unknown>;
  scope?: StartScope | undefined;
}): Promise<ConditionInsight>;
/**
 * The `$fields` entries a start GROQ requirement reads that `fields` does
 * not bind — the BINDABILITY rule every pre-flight surface applies before
 * trusting a verdict over possibly-incomplete inputs. GROQ equality against
 * a missing operand collapses to a definitive-looking answer (`null == x` is
 * false, not null), so a verdict that read an unbound entry is PROVISIONAL in
 * both directions: supplying the entry could overturn a refusal AND an
 * approval. Non-empty ⇒ report "can't decide yet" instead of the collapsed
 * verdict (the `evaluateStart` verb does; the Studio start control does).
 *
 * The GATE never consults this: at `startInstance` the supplied inputs are
 * final, so evaluating over genuine absence — including rules that WANT it,
 * like `!defined($fields.rush)` — is the correct semantics there.
 *
 * `fields` is a produced `$fields` map (`startFieldsParam`, or a surface's
 * seed map) — producers bind only own keys with real values, so key presence
 * IS the supplied-ness rule.
 */
declare function unboundRequirementReads(query: string, fields: Record<string, unknown>): string[];
/** Whether the definition declares a `singleSubject` start requirement. */
declare function hasSingleSubjectRequirement(definition: Pick<ApplicabilitySource, 'start'>): boolean;
/**
 * Evaluate a declared `singleSubject` requirement — resolves `true` when it
 * REFUSES the start: an in-flight instance (no `completedAt`) of THIS
 * definition already holds the prospective subject. The subject resolves from
 * the `$fields` map's subject entry (a GDR envelope, `.id` the identity),
 * falling back to `scope.subject`. No subject in hand means nothing to compare — the requirement
 * passes; a pre-flight surface reports the unbound subject entry as
 * provisional through {@link unboundRequirementReads}. The rule is
 * count-shaped, so an absent `scope.fetchDataset` THROWS like a
 * dataset-reading GROQ requirement — an empty `*` would pass vacuously. One
 * evaluator serves every moment: the `startInstance` gate enforces it
 * (`StartNotAllowedError`), the `evaluateStart` verb pre-flights it, and start
 * surfaces evaluate it directly for their controls — every site gated by
 * {@link hasSingleSubjectRequirement}, so only a rule this engine knows arrives
 * here (an absent or unsupported rule is the caller's contract violation).
 * Advisory under races like every engine-side check.
 */
declare function singleSubjectRequirementRefused(args: {
  definition: Pick<ApplicabilitySource, 'name' | 'fields' | 'start'>;
  /** A produced `$fields` map (`startFieldsParam`, or a surface's seed map). */
  fields?: Record<string, unknown> | undefined;
  scope?: StartScope | undefined;
}): Promise<boolean>;
/**
 * The subset of `@sanity/client` the engine actually needs. The
 * `@sanity-labs/client-fake-for-test` TestClient is
 * structurally assignable to this, as is the real `@sanity/client`
 * SanityClient.
 */
interface WorkflowMutationOptions {
  /**
   * Optimistic concurrency: only proceed if the target document's
   * current `_rev` matches. On mismatch the underlying client throws.
   * Pass the `_rev` loaded alongside the doc you're about to write back.
   */
  ifRevisionId?: string;
}
/**
 * Perspective layering — see Sanity Content Lake docs. The engine
